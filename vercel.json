{
  "rewrites": [
    {
      "source": "/auth/:path*",
      "destination": "https://profile-intelligence-service-rcl7.vercel.app/auth/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "https://profile-intelligence-service-rcl7.vercel.app/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}